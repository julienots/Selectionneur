{
  "name": "selectionneur",
  "version": "4.5.0",
  "private": true,
  "description": "Sélectionneur — manager de foot avec match en direct dans un stade 3D (web + APK Android via Capacitor)",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "check": "node scripts/check.mjs",
    "standalone": "node scripts/build-standalone.mjs",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "sync": "npx cap sync android",
    "apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "three": "^0.160.0"
  }
}
